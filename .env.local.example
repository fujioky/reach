# ── Required ──────────────────────────────────────────────────────────────
# Postgres (Neon / Vercel Postgres / any Postgres 14+). Migrations: `npm run db:migrate`.
POSTGRES_URL=postgres://user:password@host:5432/reach
# Auth.js session secret: `openssl rand -base64 32`
AUTH_SECRET=
# Vercel Blob read/write token (article images, avatars)
BLOB_READ_WRITE_TOKEN=

# ── Upstream content fetcher (Agent Reach) ────────────────────────────────
# Both can also be set at runtime in 后台 → 系统设置 → Agent Reach 接口.
# Env values take precedence over the database settings.
AGENT_REACH_BASE_URL=https://agent-reach.example.com
AGENT_REACH_PWD=

# ── Optional ──────────────────────────────────────────────────────────────
# Canonical site origin (share links, OpenGraph, analytics origin check).
# Defaults to the Vercel production URL when unset.
NEXT_PUBLIC_SITE_URL=https://reach.example.com
# Protects /api/cron/* (Vercel sets the header automatically for cron jobs)
CRON_SECRET=
# Key for the AI media parser (系统设置 → AI 解析引擎); the settings form can hold it instead.
AI_PARSER_API_KEY=
# Cloudflare Turnstile gate for visitor pages (/s/*, /p/*); leave both empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
